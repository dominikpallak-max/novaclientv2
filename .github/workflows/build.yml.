name: build

on: [push, workflow_dispatch]

jobs:
build:
runs-on: ubuntu-latest
steps:

- uses: actions/checkout@v4

- uses: actions/setup-java@v4
  with:
  distribution: temurin
  java-version: 21

  - uses: gradle/actions/setup-gradle@v4
    with:
    gradle-version: 9.2.0

  - name: Rozpakuj archiwum zip i znajdź katalog
    run: |
    ZIP_FILE=$(find . -maxdepth 1 -name "*.zip" | head -1)
    echo "Znaleziono archiwum: $ZIP_FILE"
    unzip -q "$ZIP_FILE" -d unpacked
    DIR=$(dirname "$(find unpacked -name settings.gradle | head -1)")
    echo "Projekt w: $DIR"
    echo "PROJECT_DIR=$DIR" >> "$GITHUB_ENV"

  - name: Poprawka getPos
    run: |
    FILE_PATH=$(find unpacked -name CheatModules.java | head -1)
    echo "Znaleziono plik: $FILE_PATH"
    sed -i 's|double d = pos.getSquaredDistance(p.getPos());|double d = (pos.getX()+0.5-p.getX())(pos.getX()+0.5-p.getX()) + (pos.getY()+0.5-p.getY())(pos.getY()+0.5-p.getY()) + (pos.getZ()+0.5-p.getZ())*(pos.getZ()+0.5-p.getZ());|' "$FILE_PATH"

  - name: Build
    working-directory: ${{ env.PROJECT_DIR }}
    run: gradle build

  - uses: actions/upload-artifact@v4
    with:
    name: novaclient
    path: ${{ env.PROJECT_DIR }}/build/libs/*.jar
